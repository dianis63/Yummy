<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_input"
    android:clipChildren="false"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Nombre + quitar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etIngName"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field_inner"
            android:fontFamily="@font/segoe_ui"
            android:hint="@string/hint_ingredient_name"
            android:imeOptions="actionNext"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLength="60"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/btnRemove"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_remove_ingredient"
            android:padding="10dp"
            android:src="@drawable/ic_trash"
            app:tint="@color/text_hint" />
    </LinearLayout>

    <!-- Cantidad (− / +) y unidad -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/stepperField"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field_inner"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnMinus"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_decrease"
                android:padding="14dp"
                android:src="@drawable/ic_minus"
                app:tint="@color/text_secondary" />

            <EditText
                android:id="@+id/etQty"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/segoe_ui_bold"
                android:gravity="center"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="8"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/btnPlus"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_increase"
                android:padding="14dp"
                android:src="@drawable/ic_add"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/unitField"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_field_inner"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/txtUnit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/segoe_ui"
                android:freezesText="true"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_down" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>