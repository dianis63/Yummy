<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/btnCheck"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_circle_outline"
        android:clickable="true"
        android:contentDescription="@string/cd_shopping_check"
        android:focusable="true"
        android:padding="7dp"
        app:tint="@color/white" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtName"
            style="@style/YummyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtSub"
            style="@style/YummyBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/btnRemove"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/tile_neutral"
        android:clickable="true"
        android:contentDescription="@string/cd_shopping_remove"
        android:focusable="true"
        android:padding="9dp"
        android:src="@drawable/ic_close"
        app:tint="@color/icon_gray" />
</LinearLayout>
