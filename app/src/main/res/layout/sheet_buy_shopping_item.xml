<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:alpha="0.5"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/text_hint" />

    <TextView
        style="@style/YummyTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="start"
        android:text="@string/shopping_buy_title"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/txtItemName"
        style="@style/YummyBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="start"
        android:textColor="@color/text_primary" />

    <!-- Cantidad + unidad fija -->
    <TextView
        style="@style/YummyFieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/field_quantity" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            style="@style/YummyInputContainer"
            android:layout_width="132dp"
            android:layout_height="54dp">

            <EditText
                android:id="@+id/etQty"
                style="@style/YummyEditText"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="numberDecimal"
                android:maxLength="8"
                android:paddingStart="0dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/btnQtyUp"
                    android:layout_width="30dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_increase"
                    android:padding="2dp"
                    android:src="@drawable/ic_chevron_up" />

                <ImageView
                    android:id="@+id/btnQtyDown"
                    android:layout_width="30dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_decrease"
                    android:padding="2dp"
                    android:src="@drawable/ic_chevron_down" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtUnit"
            style="@style/YummyBody"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_marginStart="12dp"
            android:gravity="center_vertical"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Ubicación -->
    <TextView
        style="@style/YummyFieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/field_location" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/locationsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Fecha de vencimiento -->
    <TextView
        style="@style/YummyFieldLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/field_expiry_date" />

    <LinearLayout
        android:id="@+id/dateField"
        style="@style/YummyInputContainer"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/txtDate"
            style="@style/YummyBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:hint="@string/hint_expiry_date"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_calendar"
            app:tint="@color/icon_gray" />
    </LinearLayout>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:clipChildren="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_outline"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/segoe_ui_bold"
            android:gravity="center"
            android:text="@string/dialog_cancel"
            android:textColor="@color/primary"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center"
            android:outlineAmbientShadowColor="@color/primary"
            android:outlineSpotShadowColor="@color/primary">

            <TextView
                android:id="@+id/txtSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="@string/shopping_buy_cta"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>