<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.auth.RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="8dp"
        android:paddingEnd="32dp"
        android:paddingBottom="24dp">

        <!-- Botón volver -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="@string/cd_back"
            android:elevation="3dp"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/icon_gray" />

        <TextView
            style="@style/YummyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="start"
            android:text="@string/register_title" />

        <TextView
            style="@style/YummyBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="start"
            android:text="@string/register_subtitle"
            android:textSize="14sp" />

        <!-- Nombre -->
        <LinearLayout
            style="@style/YummyInputContainer"
            android:layout_marginTop="16dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_person"
                app:tint="@color/icon_gray" />

            <EditText
                android:id="@+id/etName"
                style="@style/YummyEditText"
                android:autofillHints="name"
                android:hint="@string/hint_name"
                android:inputType="textPersonName" />
        </LinearLayout>

        <!-- Correo -->
        <LinearLayout
            style="@style/YummyInputContainer"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mail"
                app:tint="@color/icon_gray" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/YummyEditText"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- Contraseña -->
        <LinearLayout
            style="@style/YummyInputContainer"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock"
                app:tint="@color/icon_gray" />

            <EditText
                android:id="@+id/etPassword"
                style="@style/YummyEditText"
                android:autofillHints="newPassword"
                android:hint="@string/hint_password"
                android:inputType="textPassword" />

            <ImageView
                android:id="@+id/btnTogglePassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/cd_toggle_password"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Personas en tu hogar -->
        <TextView
            style="@style/YummyBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/segoe_ui_bold"
            android:text="@string/register_household"
            android:textColor="@color/icon_gray"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/chip1"
                style="@style/YummyPersonChip"
                android:layout_marginEnd="8dp"
                android:text="1" />

            <TextView
                android:id="@+id/chip2"
                style="@style/YummyPersonChip"
                android:layout_marginEnd="8dp"
                android:text="2" />

            <TextView
                android:id="@+id/chip3"
                style="@style/YummyPersonChip"
                android:layout_marginEnd="8dp"
                android:text="3" />

            <TextView
                android:id="@+id/chip4"
                style="@style/YummyPersonChip"
                android:layout_marginEnd="8dp"
                android:text="4" />

            <TextView
                android:id="@+id/chip5"
                style="@style/YummyPersonChip"
                android:layout_marginEnd="8dp"
                android:text="5" />

            <TextView
                android:id="@+id/chip6"
                style="@style/YummyPersonChip"
                android:text="6+" />
        </LinearLayout>

        <!-- Botón -->
        <TextView
            android:id="@+id/btnRegister"
            style="@style/YummyButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:outlineAmbientShadowColor="@color/primary"
            android:outlineSpotShadowColor="@color/primary"
            android:text="@string/register_button"
            tools:targetApi="p" />

        <!-- Link a login -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                style="@style/YummyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_have_account"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnGoLogin"
                style="@style/YummyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="@string/register_login"
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>