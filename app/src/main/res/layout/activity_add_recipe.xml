<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.addrecipe.AddRecipeActivity">

    <!-- Encabezado -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip_translucent"
            android:contentDescription="@string/cd_back"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/YummyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="@string/add_recipe_subtitle"
                android:textColor="#E6FFFFFF"
                android:textSize="13sp" />

            <TextView
                style="@style/YummyTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:text="@string/add_recipe_title"
                android:textColor="@color/white"
                android:textSize="24sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Formulario -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <!-- Imagen -->
            <TextView
                style="@style/YummyFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/field_recipe_image" />

            <FrameLayout
                android:id="@+id/imageCard"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:clipToOutline="true"
                android:elevation="3dp"
                android:focusable="true">

                <ImageView
                    android:id="@+id/imgCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/ring_yellow"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/txtImageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pill_dark"
                    android:fontFamily="@font/segoe_ui_bold"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp"
                    android:text="@string/recipe_image_add"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </FrameLayout>

            <!-- Nombre -->
            <TextView
                style="@style/YummyFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/field_recipe_name" />

            <LinearLayout
                style="@style/YummyInputContainer"
                android:layout_height="54dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etName"
                    style="@style/YummyEditText"
                    android:hint="@string/hint_recipe_name"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:maxLength="80"
                    android:paddingStart="0dp" />
            </LinearLayout>

            <!-- Tiempo -->
            <TextView
                style="@style/YummyFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/field_recipe_time" />

            <LinearLayout
                style="@style/YummyInputContainer"
                android:layout_height="54dp"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/etMinutes"
                    style="@style/YummyEditText"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingStart="0dp"
                    android:text="15" />
            </LinearLayout>

            <!-- Tipo de comida -->
            <TextView
                style="@style/YummyFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/field_recipe_meal" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipBreakfast"
                        style="@style/YummyChip"
                        android:layout_width="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:elevation="2dp"
                        android:text="@string/meal_breakfast" />

                    <TextView
                        android:id="@+id/chipLunch"
                        style="@style/YummyChip"
                        android:layout_width="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:elevation="2dp"
                        android:text="@string/meal_lunch" />

                    <TextView
                        android:id="@+id/chipDinner"
                        style="@style/YummyChip"
                        android:layout_width="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:elevation="2dp"
                        android:text="@string/meal_dinner" />

                    <TextView
                        android:id="@+id/chipSnack"
                        style="@style/YummyChip"
                        android:layout_width="wrap_content"
                        android:elevation="2dp"
                        android:text="@string/meal_snack" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Dificultad -->
            <TextView
                style="@style/YummyFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/field_recipe_difficulty" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:orientation="horizontal"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/chipEasy"
                    style="@style/YummyChip"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:elevation="2dp"
                    android:text="@string/difficulty_easy" />

                <TextView
                    android:id="@+id/chipMedium"
                    style="@style/YummyChip"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:elevation="2dp"
                    android:text="@string/difficulty_medium" />

                <TextView
                    android:id="@+id/chipHard"
                    style="@style/YummyChip"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:elevation="2dp"
                    android:text="@string/difficulty_hard" />
            </LinearLayout>

            <!-- Ingredientes -->
            <TextView
                style="@style/YummyFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/field_recipe_ingredients" />

            <LinearLayout
                android:id="@+id/ingredientsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipChildren="false"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/btnAddIngredient"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_add_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_add"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/segoe_ui_bold"
                    android:text="@string/btn_add_ingredient"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Pasos -->
            <TextView
                style="@style/YummyFieldLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/field_recipe_steps" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:elevation="3dp"
                android:padding="16dp">

                <EditText
                    android:id="@+id/etSteps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="@font/segoe_ui"
                    android:gravity="top|start"
                    android:hint="@string/hint_recipe_steps"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="5"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Botón guardar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/primary"
            android:outlineSpotShadowColor="@color/primary">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_check" />

            <TextView
                android:id="@+id/txtSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="@string/btn_save_recipe"
                android:textColor="@color/white"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>