<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.auth.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="64dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/app_name"
            android:src="@drawable/img_yummy_logo" />

        <TextView
            style="@style/YummyBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_welcome" />

        <!-- Correo -->
        <LinearLayout
            style="@style/YummyInputContainer"
            android:layout_marginTop="32dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_mail"
                app:tint="@color/icon_gray" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/YummyEditText"
                android:autofillHints="emailAddress"
                android:hint="@string/hint_email"
                android:inputType="textEmailAddress" />
        </LinearLayout>

        <!-- Contraseña -->
        <LinearLayout
            style="@style/YummyInputContainer"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_lock"
                app:tint="@color/icon_gray" />

            <EditText
                android:id="@+id/etPassword"
                style="@style/YummyEditText"
                android:autofillHints="password"
                android:hint="@string/hint_password"
                android:inputType="textPassword" />

            <ImageView
                android:id="@+id/btnTogglePassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/cd_toggle_password"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Botón -->
        <TextView
            android:id="@+id/btnLogin"
            style="@style/YummyButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:outlineAmbientShadowColor="@color/primary"
            android:outlineSpotShadowColor="@color/primary"
            android:text="@string/login_button"
            tools:targetApi="p" />

        <!-- Link a registro -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                style="@style/YummyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_no_account"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnGoRegister"
                style="@style/YummyBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/segoe_ui_bold"
                android:text="@string/login_register"
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>