<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Yummy" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Yummy.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Yummy.AlertDialog</item>
    </style>
    <!-- Estilos de texto reutilizables (tipografía Segoe UI) -->
    <style name="YummyTitle">
        <item name="android:fontFamily">@font/segoe_ui_bold</item>
        <item name="android:textSize">27sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="YummyBody">
        <item name="android:fontFamily">@font/segoe_ui</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="YummyButton">
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/segoe_ui_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:elevation">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="YummyChip">
        <item name="android:layout_height">36dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:fontFamily">@font/segoe_ui_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:background">@drawable/bg_chip_white</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Theme.Yummy" parent="Base.Theme.Yummy" />

    <!-- Contenedor blanco del campo (ícono + texto) -->
    <style name="YummyInputContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:elevation">3dp</item>
    </style>

    <!-- Texto dentro del campo -->
    <style name="YummyEditText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@null</item>
        <item name="android:fontFamily">@font/segoe_ui</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Chips de "Personas en tu hogar" -->
    <style name="YummyPersonChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/segoe_ui_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/icon_gray</item>
        <item name="android:background">@drawable/bg_person_chip</item>
        <item name="android:elevation">2dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="YummySectionLabel">
        <item name="android:fontFamily">@font/segoe_ui_bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Etiqueta de cada campo de los formularios -->
    <style name="YummyFieldLabel" parent="YummyBody">
        <item name="android:fontFamily">@font/segoe_ui_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/icon_gray</item>
        <item name="android:gravity">start</item>
    </style>

    <!-- Diálogo de pantalla completa (detalle de producto) -->
    <style name="Theme.Yummy.FullScreenDialog" parent="Theme.Yummy">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Hojas inferiores: el fondo lo pinta BottomSheetBehavior, por eso va por tema -->
    <style name="ThemeOverlay.Yummy.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Yummy.BottomSheet</item>
    </style>

    <style name="Widget.Yummy.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/background</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Yummy.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Yummy.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- Diálogos: Material3 los pinta con colorSurface (lila) y botones morados -->
    <style name="ThemeOverlay.Yummy.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorSurfaceContainerHigh">@color/background</item>
        <!-- Sin esto M3 tiñe el crema con colorPrimary y sale durazno -->
        <item name="elevationOverlayEnabled">false</item>
        <!-- Material3 usa Roboto; aquí se cambia a la Segoe del resto de la app -->
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Yummy.Dialog.Title</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Yummy.Dialog.Body</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Yummy.Dialog.Item</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Yummy.Dialog.Button</item>
    </style>

    <style name="TextAppearance.Yummy.Dialog.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/segoe_ui_bold</item>
        <item name="android:fontFamily">@font/segoe_ui_bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Yummy.Dialog.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/segoe_ui</item>
        <item name="android:fontFamily">@font/segoe_ui</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Yummy.Dialog.Item" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/segoe_ui</item>
        <item name="android:fontFamily">@font/segoe_ui</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Yummy.Dialog.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/segoe_ui_bold</item>
        <item name="android:fontFamily">@font/segoe_ui_bold</item>
    </style>

    <!-- Calendario de la fecha de vencimiento (colores de Yummy) -->
    <style name="ThemeOverlay.Yummy.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/background</item>
        <item name="colorSurfaceContainerHigh">@color/background</item>
        <item name="elevationOverlayEnabled">false</item>
        <!-- Solo la fuente: el color lo maneja el calendario segun el estado del dia -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Yummy.Picker.Headline</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Yummy.Picker.Body</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Yummy.Picker.Label</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Yummy.Picker.Caption</item>
    </style>

    <style name="TextAppearance.Yummy.Picker.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">@font/segoe_ui_bold</item>
        <item name="android:fontFamily">@font/segoe_ui_bold</item>
    </style>

    <style name="TextAppearance.Yummy.Picker.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/segoe_ui</item>
        <item name="android:fontFamily">@font/segoe_ui</item>
    </style>

    <style name="TextAppearance.Yummy.Picker.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/segoe_ui_bold</item>
        <item name="android:fontFamily">@font/segoe_ui_bold</item>
    </style>

    <style name="TextAppearance.Yummy.Picker.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/segoe_ui</item>
        <item name="android:fontFamily">@font/segoe_ui</item>
    </style>

</resources>